{
  "name": "atiroop/jocky-media-offloader",
  "description": "Safe Cloudflare R2 connectivity foundation for WordPress media.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3",
    "aws/aws-sdk-php": "^3.403.6"
  },
  "autoload": {
    "psr-4": {
      "Jocky\\MediaOffloader\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Jocky\\MediaOffloader\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:integration": "phpunit --configuration phpunit-integration.xml.dist",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "require-dev": {
    "phpunit/phpunit": "9.6.33",
    "squizlabs/php_codesniffer": "3.13.6",
    "wp-coding-standards/wpcs": "3.4.1",
    "yoast/phpunit-polyfills": "1.1"
  }
}
